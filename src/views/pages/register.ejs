<%- include('../partials/header', {}) %>


<main class="bg-light position-relative d-flex align-items-center justify-content-center flex-grow-1 px-3">
    
    
    <div class="position-absolute top-0 start-0 w-100" style="height: 40%; background-color: #1abc9c;"></div>


    <div class="card p-4 shadow-lg border-0 z-1 mb-5" style="width: 100%; max-width: 400px; border-radius: 1.2rem;">
        
        <div class="card-body text-center">
            <h2 class="mb-4 fw-normal">¡Registrate!</h2>


            <form>
                <div class="mb-4">
                    
                    <input type="text" class="form-control rounded-pill" id="name1" aria-describedby="emailHelp" placeholder="Nombre">
                    
                </div>
                <div class="mb-4">
                    
                    <input type="email" class="form-control rounded-pill" id="inputEmail" placeholder="Tu email">
                </div>
                <div class="mb-4">
                    
                    <input type="password" class="form-control rounded-pill" id="password1" placeholder="Tu contraseña">
                </div>
                <button type="submit" class="btn btn-dark w-100 rounded-pill mb-3">Crear cuenta</button>

                    <p class="text-muted small">
                        ¿Ya tienes cuenta?<a href="/login" class="text-decoration-undeline text-dark"> Inicia Sesion</a>
                    </p>

                </form>
            
            
            
        </div>
        
    </div>

</main>


<%- include('../partials/footer', {}) %>