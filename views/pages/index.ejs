<%- include('../partials/header', {}) %>

<main class="bg-light flex-grow-1 py-4">


    <div class="bg-dark rounded-4 py-3 px-4 mb-4 mx-3 mx-lg-auto" style="max-width: 1200px;">
    
    <div class="row g-3 g-md-4">
        
        <% if (locals.categorias) { %>  
            <% categorias.forEach(function(categoria) { %>
                
                <div class="col-12 col-md-3 col-lg">
                    
                    <a href="#" class="text-white text-decoration-none d-flex flex-row flex-md-column align-items-center opacity-75">
                        
                        <i class="bi <%= categoria.icono %> fs-3 me-3 me-md-0 mb-md-1"></i>
                        <span><%= categoria.nombre %></span>
                        
                    </a>
                </div>
                
            <% }); %>
        <% } %>

    </div>


    
</div>

<div class="container-fluid pb-4 mb-5" style="background-color: #1abc9c; margin-top: 80px;">
    
    <div class="container">
        <div class="row justify-content-center g-4" style="margin-top: -60px;">
            
            <!-- Columna Banner 1 -->
            <div class="col-12 col-md-6 d-flex justify-content-center">
                
                <div class="card border-0 shadow-lg w-100 overflow-hidden text-white rounded-4" style="max-width: 500px; min-height: 220px;">
                    <!-- Capa 1: Imagen de fondo -->
                    <div class="position-absolute top-0 start-0 w-100 h-100" style="background-image: url('ruta-deadpool.jpg'); background-size: cover; background-position: center; z-index: 0;"></div>
                    
                    <!-- Capa 2: Filtro oscuro -->
                    <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-50" style="z-index: 1;"></div>
                    
                    <!-- Capa 3: Contenido -->
                    <div class="card-body d-flex align-items-end position-relative p-3 p-md-4" style="z-index: 2;">
                        
                        <!-- Contenedor Flexbox para alinear el logo y el texto lado a lado -->
                        <div class="d-flex align-items-center gap-3 w-100">
                            
                            <!-- Recuadro Blanco (Logo) -->
                            <div class="bg-white rounded-3 shadow-sm d-flex justify-content-center align-items-center flex-shrink-0" style="width: 80px; height: 80px;">
                                <!-- Acá iría la imagen real del logo (con img-fluid para que se adapte al cuadradito) -->
                                <span class="text-dark fw-bold small">Logo</span> 
                            </div>

                            <!-- Bloque de Texto -->
                            <div>
                                <h4 class="card-title fw-bold mb-1 fs-5 fs-md-4">50% OFF en Combo Plus</h4>
                                <p class="card-text small mb-0">Canjeando 50.000 puntos MiEcommerce</p>
                            </div>

                        </div>

                    </div>
                </div>

            </div>

            <div class="col-12 col-md-6 d-flex justify-content-center">
                
                <div class="card border-0 shadow-lg w-100 overflow-hidden text-white rounded-4" style="max-width: 500px; min-height: 220px;">
                    <div class="position-absolute top-0 start-0 w-100 h-100" style="background-image: url('ruta-hbo.jpg'); background-size: cover; background-position: center; z-index: 0;"></div>
                    
                    <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-50" style="z-index: 1;"></div>
                    
                    <div class="card-body d-flex align-items-end position-relative p-3 p-md-4" style="z-index: 2;">
                        
                        <!-- Contenedor Flexbox para alinear el logo y el texto lado a lado -->
                        <div class="d-flex align-items-center gap-3 w-100">
                            
                            <!-- Recuadro Blanco (Logo) -->
                            <div class="bg-white rounded-3 shadow-sm d-flex justify-content-center align-items-center flex-shrink-0" style="width: 80px; height: 80px;">
                                <!-- Acá iría la imagen real del logo (con img-fluid para que se adapte al cuadradito) -->
                                <span class="text-dark fw-bold small">Logo</span> 
                            </div>

                            <!-- Bloque de Texto -->
                            <div>
                                <h4 class="card-title fw-bold mb-1 fs-5 fs-md-4">50% OFF en Combo Plus</h4>
                                <p class="card-text small mb-0">Canjeando 50.000 puntos MiEcommerce</p>
                            </div>

                        </div>

                    </div>
                </div>

            </div>

        </div>
    </div>
</div>

<div class="container mb-5">
    <h3 class="mb-4">Te puede interesar</h3>

    <div class="row g-4">
        <% if (locals.products) { %>  
            <% products.forEach(function(producto) { %>

                <div class="col-12 col-md-6 col-lg-3 d-flex align-items-center">
                    <div class="card border-0 shadow-sm w-100">

                        <div style="height: 200px; background-color: #e9ecef;"></div>
                            <a href="/product/<%= producto.id %>" class="stretched-link text-decoration-none text-dark">
                                <div class="card-body d-flex flex-column"> 
                                    <h6 class="card-title"> <%= producto.nombre %> </h6>
                                    <p class="card-text fw-bold fs-5 mt-auto -b-0"> <%= producto.precio %> </p>
                                    <small class="text-muted"> ARS </small>

                                </div>
                            </a>
                        
                    </div>

                </div>

            <% }); %>
        <% } %>
    </div>
</div>
<div class="container mb-5">
    <h3 class="mb-4">Los más pedidos</h3>

    <div class="row g-4">
        <% if (locals.products) { %>  
            <% products.forEach(function(producto) { %>

                <div class="col-12 col-md-6 col-lg-3 d-flex align-items-stretch">
                    <div class="card border-0 shadow-sm w-100">

                        <div style="height: 200px; background-color: #e9ecef;"></div>
                            
                    </div>

                </div>

            <% }); %>
        <% } %>
    </div>
</div>

<div class="bg-dark rounded-4 py-3 px-4 mb-4 mx-3 mx-lg-auto" style="max-width: 1200px;">
    
    <div class="row g-3 g-md-4">
        
        <% if (locals.categorias) { %>  
            <% categorias.forEach(function(categoria) { %>
                
                <div class="col-12 col-md-3 col-lg">
                    
                    <a href="#" class="text-white text-decoration-none d-flex flex-row flex-md-column align-items-center opacity-75">
                        
                        <i class="bi <%= categoria.icono %> fs-3 me-3 me-md-0 mb-md-1"></i>
                        <span><%= categoria.nombre %></span>
                        
                    </a>
                </div>
                
            <% }); %>
        <% } %>

    </div>


</main>

<%- include('../partials/footer', {}) %>                                                                                            