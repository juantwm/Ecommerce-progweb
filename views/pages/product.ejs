<%- include('../partials/header', {}) %>

<main class="bg-light flex-grow-1 py-4">


<div class="container mb-5">
    <% if (locals.error) { %>  
    <div class="text-center py-5 mb-5">
            <h2 class="fw-bold text-danger">¡Ups! Producto no encontrado</h2>
            <p class="text-muted">El producto que buscás no existe o el enlace es incorrecto.</p>
            <a href="/" class="btn btn-outline-dark mt-3">Volver al inicio</a>
    </div>
    <% } else if(locals.producto) { %>

        <div class="card p-4 shadow-sm border-0 rounded-4">
                <div class="row g-4">

                    <!-- Columna izquierda - imagenes -->
                    <div class="col-12 col-md-7 d-flex gap-3">
                        <div class="d-flex flex-column gap-2" style="width: 80px;">
                            <% if (producto.imagenes && producto.imagenes.length > 0) { %>
                                <% producto.imagenes.forEach(function(img, index) { %>
                                    <img src="<%= img %>" 
                                        class="img-fluid rounded border <%= index === 0 ? 'border-dark' : 'border-secondary-subtle' %>" 
                                        style="cursor: pointer; height: 75px; object-fit: cover;" 
                                        alt="Miniatura">
                                <% }); %>
                            <% } %>
                        </div>

                        <div class="flex-grow-1 bg-light rounded d-flex justify-content-center align-items-center overflow-hidden position-relative" style="min-height: 350px;">
                            <% if (producto.imagenes && producto.imagenes.length > 0) { %>
                                <img id="imagenPrincipal" src="<%= producto.imagenes[0] %>" class="img-fluid object-fit-cover w-100 h-100 zoom-img" style="max-height: 480px;" alt="<%= producto.nombre %>">
                            <% } else { %>
                                <div class="text-muted">Sin imagen disponible</div>
                            <% } %>
                        </div>
                    </div>

                    <!-- Columna derecha - descripcion -->
                    <div class="col-12 col-md-5 d-flex flex-column justify-content-start">
                        <h1 class="fs-3 fw-bold mb-2"><%= producto.nombre %></h1>

                        <p class="fs-1 fw-bold mb-3">
                            <%= producto.precio %> 
                            <span class="fs-6 text-muted fw-normal">ARS</span>
                        </p>

                        <button type="button" class="btn btn-secondary w-100 rounded-pill py-2 mb-4 fw-bold">
                            Agregar al carrito
                        </button>

                        <div class="text-muted small">
                            <p><%= producto.descripcion %></p>
                        </div>
                    </div>

                </div>
            </div>
        
    <% } %>
</div>

    
<div class="container mb-5">
        <h3 class="mb-4"><%= locals.error ? 'Productos sugeridos' : 'También te puede interesar' %></h3>

        <div class="row g-4">
            <% if (locals.productosRelacionados && productosRelacionados.length > 0) { %>  
                <% productosRelacionados.forEach(function(item) { %>
                    <div class="col-12 col-md-6 col-lg-3 d-flex align-items-stretch">
                        <div class="card border-0 shadow-sm w-100 position-relative">
                            <div style="height: 200px; background-color: #e9ecef;" class="d-flex align-items-center justify-content-center text-muted">
                                <i class="bi bi-image fs-1"></i>
                            </div>
                            <div class="card-body d-flex flex-column"> 
                                <a href="/product/<%= item.id %>" class="stretched-link text-decoration-none text-dark">
                                    <h6 class="card-title mb-2"><%= item.nombre %></h6>
                                </a>
                                <p class="card-text fw-bold fs-5 mt-auto mb-0"><%= item.precio %></p>
                                <small class="text-muted">ARS</small>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <p class="text-muted ps-3">No hay productos relacionados disponibles.</p>
            <% } %>
        </div>
</div>

<div class="container mb-5">
    <div class="bg-dark rounded-4 py-3 px-4 mb-4 mx-3 mx-lg-auto" style="max-width: 1200px;">
    
        <div class="row g-3 g-md-4">
            
            <% if (locals.categorias) { %>  
                <% categorias.forEach(function(categoria) { %>
                    
                    <div class="col-12 col-md-3 col-lg">
                        
                        <a href="#" class="text-white text-decoration-none d-flex flex-row flex-md-column align-items-center opacity-75">
                            
                            <i class="bi <%= categoria.icono %> fs-3 me-3 me-md-0 mb-md-1"></i>
                            <span><%= categoria.nombre %></span>
                            
                        </a>
                    </div>
                    
                <% }); %>
            <% } %>

        </div>
    </div>
</div>




</main>



<%- include('../partials/footer', {}) %>                                                                                            


<style>
    .zoom-img {
        transition: transform 0.3s ease;
        cursor: zoom-in;
    }
    .zoom-img:hover {
        transform: scale(1.5);
    }
</style>
